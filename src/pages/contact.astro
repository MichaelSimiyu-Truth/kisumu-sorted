---
import Layout from '../layouts/Layout.astro';

// ── Contact details: change them here once and the whole page updates ──
const phoneNumber = '254708590488'; // international format, no + or spaces. TODO: confirm with the founders
const phoneDisplay = '+254708590488';
const channelUrl = 'https://whatsapp.com/channel/0029VbDmfjZ7IUYbCp8V5F21';
const instagramUrl = 'https://www.instagram.com/kisumu_sorted/';
const tiktokUrl = 'https://www.tiktok.com/@kisumusorted';

// wa.me opens a real chat with a message already typed in
const wa = (text: string) => `https://wa.me/${phoneNumber}?text=${encodeURIComponent(text)}`;
const listWa = wa("Hi Kisumu Sorted, I'd like to list my business.");
const pricingWa = wa('Hi Kisumu Sorted, what are your listing packages and rates?');

// ── Page content ──
const steps = [
  { title: 'Message us', text: 'Tell us about your business on WhatsApp or with the form below.' },
  { title: 'Agree your package', text: 'We confirm what your listing includes and the fee.' },
  { title: 'Pay the team directly', text: 'We share the payment details with you. Nothing is paid on this website.' }, // TODO: confirm payment method
  { title: 'Go live', text: 'We publish your page and it appears in the directory.' },
];

const included = [
  'Your own page with your photos and description',
  'WhatsApp and call buttons, so customers reach you in one tap',
  'A map link to your location',
  'A place in the category and area filters',
]; // Add extras (e.g. a social media feature) only once the founders confirm them

const toSend = [
  'Business name',
  'Category (eat & drink, stay, explore, shop, or music & nightlife)',
  'Area of Kisumu',
  'Phone and WhatsApp number',
  '2 to 3 clear photos (you can send them on WhatsApp)',
  'A short description, 2 to 3 sentences',
  'Social media links and a map location, if you have them',
];

// Add real questions and answers here once the founders confirm them. The FAQ section only shows when this list has items.
const faqs: { q: string; a: string }[] = [];
// Example: { q: 'How long does a listing last?', a: '...' }

// ── Contact options ──
const contacts = [
  { label: 'Message us on WhatsApp', note: 'Fastest way to reach us', href: listWa, external: true, icon: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z' },
  { label: phoneDisplay, note: 'Call us', href: `tel:+${phoneNumber}`, external: false, icon: 'M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z' },
  { label: 'Instagram', note: '@kisumu_sorted', href: instagramUrl, external: true,
  markup: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/>' },
  { label: 'TikTok', note: '@kisumusorted', href: tiktokUrl, external: true, icon: 'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z' },
  { label: 'WhatsApp channel', note: 'Updates and new listings', href: channelUrl, external: true, icon: 'M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z' },
];

// Shared classes so the form fields stay consistent
const field = 'w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-brand-dark focus:bg-white focus:border-brand-green focus:ring-2 focus:ring-brand-green/20 outline-none transition-colors';
const card = 'rounded-3xl border border-gray-100 bg-white p-6 shadow-[0_8px_30px_rgb(0,0,0,0.06)] md:p-10';
---

<Layout title="List Your Business in Kisumu">
  <div class="mx-auto max-w-5xl font-body py-4 md:py-8">

    <!-- 1. Hero -->
    <header class="mx-auto max-w-3xl text-center">
      <h1 class="font-heading text-4xl font-extrabold leading-tight text-brand-green md:text-6xl">
        Get your business listed in
        <span class="relative inline-block isolate">Kisumu
          <span class="absolute bottom-1 left-0 -z-10 h-2 w-full bg-brand-orange md:h-3"></span>
        </span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-700">
        Kisumu Sorted is a local guide to places to eat, stay, shop and explore. List your business and customers can find you, then message or call you in one tap.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={listWa} target="_blank" rel="noopener noreferrer"
           class="w-full rounded-xl bg-brand-orange px-7 py-3.5 font-heading font-bold text-brand-dark shadow-sm transition-colors hover:bg-orange-500 sm:w-auto">
          Message us on WhatsApp
        </a>
        <a href="#contact" class="w-full rounded-xl border-2 border-brand-green px-7 py-3 font-heading font-bold text-brand-green transition-colors hover:bg-brand-lightgreen sm:w-auto">
          Send an email instead
        </a>
      </div>
    </header>

    <!-- 2. How to get listed -->
    <section id="get-listed" class="mt-20 scroll-mt-24" aria-labelledby="how-heading">
      <h2 id="how-heading" class="font-heading text-2xl font-extrabold text-brand-dark md:text-3xl">
        How to get your business listed in Kisumu
        <span class="mt-2 block h-1 w-12 rounded bg-brand-orange"></span>
      </h2>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, i) => (
          <li class="rounded-2xl border border-gray-200 bg-white p-6">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-green font-heading font-bold text-white" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-4 font-heading text-lg font-bold">{step.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-gray-600">{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 3. What you get / what to send -->
    <section class="mt-16 grid gap-6 md:grid-cols-2" aria-label="Listing details">
      <div class="rounded-3xl bg-brand-lightgreen p-6 md:p-10">
        <h2 class="font-heading text-2xl font-bold">What your Kisumu listing includes</h2>
        <p class="mt-2 text-sm text-gray-700">
          Every listing appears in the <a href="/" class="font-semibold text-brand-green underline hover:text-brand-orange">Kisumu business directory</a>.
        </p>
        <ul class="mt-5 space-y-3">
          {included.map((item) => (
            <li class="flex gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 fill-brand-green" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-3xl border border-gray-200 bg-white p-6 md:p-10">
        <h2 class="font-heading text-2xl font-bold">What to send us</h2>
        <p class="mt-2 text-sm text-gray-700">Have these ready and your listing will go up faster.</p>
        <ul class="mt-5 space-y-3">
          {toSend.map((item) => (
            <li class="flex gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 fill-brand-orange" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Pricing -->
    <section class="mt-16 rounded-3xl bg-brand-green p-8 text-white md:p-12" aria-labelledby="pricing-heading">
      <h2 id="pricing-heading" class="font-heading text-2xl font-extrabold md:text-3xl">Pricing</h2>
      <p class="mt-2 max-w-xl text-white/85">Fees depend on the package. Message us for current rates.</p>
      <a href={pricingWa} target="_blank" rel="noopener noreferrer"
         class="mt-6 inline-block rounded-xl bg-brand-orange px-7 py-3.5 font-heading font-bold text-brand-dark transition-colors hover:bg-orange-500">
        Ask about pricing on WhatsApp
      </a>
    </section>

    <!-- 5. Contact options and form -->
    <section id="contact" class="mt-20 scroll-mt-24" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="font-heading text-2xl font-extrabold text-brand-dark md:text-3xl">
        Contact Kisumu Sorted
        <span class="mt-2 block h-1 w-12 rounded bg-brand-orange"></span>
      </h2>

      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <!-- Contact options -->
        <div class={card}>
          <h3 class="font-heading text-xl font-bold">Reach us directly</h3>
          <p class="mt-2 text-sm text-gray-600">Pick whichever is easiest for you.</p>
          <ul class="mt-6 space-y-4">
            {contacts.map((c) => (
              <li>
                <a
                  href={c.href}
                  {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="group -m-2 flex items-center gap-4 rounded-2xl p-2 transition-colors hover:bg-brand-lightgreen/60"
                >
                  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand-green/10 transition-colors group-hover:bg-brand-orange/20">
                  <svg class="h-6 w-6 fill-brand-green text-brand-green" viewBox="0 0 24 24" aria-hidden="true">
                    {c.markup ? <Fragment set:html={c.markup} /> : <path d={c.icon} />}
                  </svg>
                    
                  </span>
                  <span>
                    <span class="block font-semibold text-brand-dark">{c.label}</span>
                    <span class="block text-sm text-gray-600">{c.note}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Form -->
        <div class={`${card} border-t-8 border-t-brand-green`}>
          <h3 class="font-heading text-xl font-bold">Send us a message</h3>
          <p class="mt-2 text-sm text-gray-600">Tell us what you need and we will get back to you.</p>

          <!-- action + method keep the form working even if JavaScript is off -->
          <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="mt-6 space-y-5">
            <input type="hidden" name="access_key" value="b56ba381-19d1-433e-9068-86a2d91c7eac" />
            <input type="hidden" name="subject" value="New enquiry from Kisumu Sorted" />
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div>
              <label for="topic" class="mb-1 block text-sm font-medium text-brand-dark">What can we help with?</label>
              <select id="topic" name="topic" class={field}>
                <option>List my business</option>
                <option>General question</option>
                <option>Report a problem</option>
              </select>
            </div>

            <div>
              <label for="name" class="mb-1 block text-sm font-medium text-brand-dark">Full name</label>
              <input type="text" id="name" name="name" required autocomplete="name" class={field} />
            </div>

            <div>
              <label for="email" class="mb-1 block text-sm font-medium text-brand-dark">Email address</label>
              <input type="email" id="email" name="email" required autocomplete="email" class={field} />
            </div>

            <div>
              <label for="phone" class="mb-1 block text-sm font-medium text-brand-dark">Phone or WhatsApp <span class="font-normal text-gray-500">(optional)</span></label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" class={field} />
            </div>

            <!-- Shown only when the topic is "List my business" -->
            <div id="listing-fields" class="space-y-5">
              <div>
                <label for="business" class="mb-1 block text-sm font-medium text-brand-dark">Business name <span class="font-normal text-gray-500">(optional)</span></label>
                <input type="text" id="business" name="business" class={field} />
              </div>
              <div>
                <label for="area" class="mb-1 block text-sm font-medium text-brand-dark">Area of Kisumu <span class="font-normal text-gray-500">(optional)</span></label>
                <input type="text" id="area" name="area" placeholder="e.g. Milimani, Dunga, CBD" class={field} />
              </div>
            </div>

            <div>
              <label for="message" class="mb-1 block text-sm font-medium text-brand-dark">How can we help?</label>
              <textarea id="message" name="message" rows="4" required class={`${field} resize-y`}></textarea>
            </div>

            <button type="submit" class="w-full rounded-xl bg-brand-orange px-6 py-4 font-heading text-lg font-bold text-brand-dark shadow-lg shadow-brand-orange/20 transition-colors hover:bg-orange-500 disabled:cursor-not-allowed disabled:opacity-60">
              Send message
            </button>

            <p id="form-status" role="status" aria-live="polite" class="hidden rounded-xl px-4 py-3 text-sm font-medium"></p>
            <p class="text-xs text-gray-500">We only use your details to reply to you.</p>
          </form>
        </div>
      </div>
    </section>

    <!-- 6. FAQ: appears only once the founders have confirmed real answers -->
    {faqs.length > 0 && (
      <section class="mt-20" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="font-heading text-2xl font-extrabold text-brand-dark md:text-3xl">
          Questions about listing your business
          <span class="mt-2 block h-1 w-12 rounded bg-brand-orange"></span>
        </h2>
        <div class="mt-8 space-y-3">
          {faqs.map((f) => (
            <details class="group rounded-2xl border border-gray-200 bg-white p-5">
              <summary class="cursor-pointer list-none font-heading font-bold [&::-webkit-details-marker]:hidden">{f.q}</summary>
              <p class="mt-3 text-gray-700">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const topic = document.getElementById('topic') as HTMLSelectElement;
    const listingFields = document.getElementById('listing-fields') as HTMLElement;
    const status = document.getElementById('form-status') as HTMLElement;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    // Show the business fields only when someone wants to be listed
    const syncTopic = () => listingFields.classList.toggle('hidden', topic.value !== 'List my business');
    topic.addEventListener('change', syncTopic);
    syncTopic();

    function showStatus(message: string, ok: boolean) {
      status.textContent = message;
      status.className = `rounded-xl px-4 py-3 text-sm font-medium ${ok ? 'bg-brand-lightgreen text-brand-green' : 'bg-red-50 text-red-700'} block`;
      status.classList.remove('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data: Record<string, FormDataEntryValue> = Object.fromEntries(new FormData(form));

      data.subject = `Kisumu Sorted enquiry: ${data.topic}`; // easy to sort in your inbox
      button.disabled = true;
      button.textContent = 'Sending…';

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (!res.ok || !result.success) throw new Error(result.message || 'Request failed');

        form.reset();
        syncTopic();
        showStatus('Thank you. We have your message and will reply to you.', true);
      } catch {
        showStatus('Something went wrong. Please try again, or message us on WhatsApp.', false);
      } finally {
        button.disabled = false;
        button.textContent = 'Send message';
      }
    });
  }
</script>