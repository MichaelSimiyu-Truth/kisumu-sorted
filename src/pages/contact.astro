---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us">
  <div class="max-w-2xl mx-auto bg-white p-8 rounded-lg shadow-md border-t-4 border-brand-orange mt-12 mb-20">
    <h1 class="text-3xl font-bold text-brand-dark mb-2 font-body">Get in Touch</h1>
    <p class="text-gray-600 mb-8 font-body">Have a question or want to suggest a new business for Kisumu Sorted? Drop us a message below.</p>
    
    <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6 font-body">
      <!-- Replace YOUR_ACCESS_KEY with the key emailed to you -->
      <input type="hidden" name="access_key" value="b56ba381-19d1-433e-9068-86a2d91c7eac">
      
      <!-- Optional: Redirect to a custom success page, or leave this out to use the default success page -->
      <!-- <input type="hidden" name="redirect" value="https://mpesa.site/success"> -->

      <!-- Spam Protection -->
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

      <div>
        <label for="name" class="block text-sm font-medium text-brand-dark mb-1">Name</label>
        <input type="text" id="name" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition-shadow">
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-brand-dark mb-1">Email</label>
        <input type="email" id="email" name="email" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition-shadow">
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-brand-dark mb-1">Message</label>
        <textarea id="message" name="message" rows="5" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition-shadow"></textarea>
      </div>

      <button type="submit" class="w-full bg-brand-green text-white font-bold py-3 px-4 rounded-md hover:opacity-90 transition-opacity shadow-sm">
        Send Message
      </button>
    </form>
  </div>
</Layout>