---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const listings = await getCollection('listings', ({ data }) => {
    return data.status === 'live';
  });

  return listings.map((listing) => ({
    params: { id: listing.id },
    props: { listing },
  }));
}

const { listing } = Astro.props;
const { 
  name, 
  category, 
  area, 
  description, 
  phone, 
  whatsapp, 
  address, 
  map_link, 
  photos, 
  featured 
} = listing.data;

const cleanWhatsapp = whatsapp ? whatsapp.replace(/[^0-9]/g, '') : '';
---

<Layout title={name}>
  <!-- Back Link -->
  <div class="mb-6">
    <a href="/" class="inline-flex items-center gap-1 text-sm font-semibold text-brand-green hover:text-brand-orange transition-colors">
      &larr; Back to all businesses
    </a>
  </div>

  <!-- Main Listing Container -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
    
    <!-- Hero Photo or Branded Fallback -->
    <div class="relative h-64 md:h-96 bg-brand-lightgreen flex items-center justify-center overflow-hidden">
      {photos && photos.length > 0 ? (
        <img 
          src={photos[0].src} 
          alt={name} 
          class="w-full h-full object-cover"
        />
      ) : (
        <span class="text-brand-green/40 font-heading font-extrabold text-3xl">
          Kisumu Sorted.
        </span>
      )}

      {featured && (
        <span class="absolute top-4 right-4 bg-brand-orange text-brand-dark text-sm font-heading font-extrabold px-4 py-1.5 rounded-full shadow z-10">
          ★ Featured Business
        </span>
      )}
    </div>

    <!-- Content Grid -->
    <div class="p-6 md:p-10 grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column: Details & Photos -->
      <div class="lg:col-span-2">
        <div class="flex flex-wrap items-center gap-2 text-sm font-medium text-brand-green mb-3">
          <span class="bg-brand-lightgreen px-3 py-1 rounded-md font-bold">{category}</span>
          <span>•</span>
          <span class="text-gray-600 font-semibold">{area}</span>
        </div>

        <h1 class="font-heading font-extrabold text-3xl md:text-4xl text-brand-dark mb-4">
          {name}
        </h1>

        <p class="text-gray-700 leading-relaxed whitespace-pre-line text-base md:text-lg mb-8">
          {description}
        </p>

        <!-- Clickable Photo Gallery Thumbnails -->
        {photos && photos.length > 0 && (
          <div class="mt-8">
            <h2 class="font-heading font-bold text-xl text-brand-dark mb-4">Photos (Tap to view full screen)</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
              {photos.map((photo, index) => (
                <button 
                  type="button"
                  data-img-src={photo.src}
                  class="gallery-thumb h-40 rounded-lg overflow-hidden bg-brand-lightgreen border-2 border-transparent hover:border-brand-orange transition-all cursor-pointer text-left p-0 focus:outline-none shadow-sm"
                >
                  <img 
                    src={photo.src} 
                    alt={`${name} photo ${index + 1}`} 
                    class="w-full h-full object-cover pointer-events-none" 
                  />
                </button>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Contact & Location Box -->
      <div class="bg-brand-offwhite p-6 rounded-xl border border-gray-200 h-fit">
        <h2 class="font-heading font-bold text-lg text-brand-dark mb-4">
          Contact & Location
          <span class="block w-8 h-1 bg-brand-orange mt-1 rounded"></span>
        </h2>

        <!-- Primary Action Buttons -->
        <div class="flex flex-col gap-3 mb-6">
          {cleanWhatsapp && (
            <a 
              href={`https://wa.me/${cleanWhatsapp}?text=${encodeURIComponent(`Hi ${name}, I found your business on Kisumu Sorted.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full bg-brand-green text-white text-center font-bold py-3 px-4 rounded-xl hover:opacity-95 transition-opacity shadow-sm"
            >
              Chat on WhatsApp
            </a>
          )}

          {phone && (
            <a 
              href={`tel:${phone}`}
              class="w-full bg-brand-orange text-brand-dark text-center font-bold py-3 px-4 rounded-xl hover:bg-orange-500 transition-colors shadow-sm"
            >
              Call {phone}
            </a>
          )}
        </div>

        <!-- Address & Map Details -->
        <div class="space-y-3 text-sm border-t border-gray-200 pt-4">
          <div>
            <span class="font-bold text-gray-900 block">Area:</span>
            <span class="text-gray-600">{area}, Kisumu</span>
          </div>

          {address && (
            <div>
              <span class="font-bold text-gray-900 block">Address:</span>
              <span class="text-gray-600">{address}</span>
            </div>
          )}

          {map_link && (
            <div class="pt-2">
              <a 
                href={map_link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block text-brand-green font-bold underline hover:text-brand-orange transition-colors"
              >
                Open in Google Maps &rarr;
              </a>
            </div>
          )}
        </div>
      </div>

    </div>
  </div>

  <!-- Full-Screen Lightbox Modal (Hidden by default) -->
  <div id="image-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <button 
      type="button" 
      id="close-modal" 
      class="absolute top-5 right-5 text-white bg-black/50 hover:bg-black w-10 h-10 rounded-full font-bold text-xl flex items-center justify-center cursor-pointer transition-colors"
      aria-label="Close modal"
    >
      &times;
    </button>
    <img id="modal-img" src="" alt="Enlarged view" class="max-w-full max-h-[90vh] object-contain rounded-xl shadow-2xl scale-95 transition-transform duration-300" />
  </div>
</Layout>

<script>
  const modal = document.getElementById('image-modal');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const closeModal = document.getElementById('close-modal');
  const thumbs = document.querySelectorAll('.gallery-thumb');

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.getAttribute('data-img-src');
      if (modal && modalImg && src) {
        modalImg.src = src;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden'; // Prevent background scrolling
        setTimeout(() => modalImg.classList.remove('scale-95'), 10);
      }
    });
  });

  function closeLightbox() {
    if (modal && modalImg) {
      modalImg.classList.add('scale-95');
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  closeModal?.addEventListener('click', closeLightbox);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>