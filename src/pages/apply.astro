---
import Layout from '../layouts/Layout.astro';
---

<Layout title="List Your Business">
  <div class="max-w-3xl mx-auto bg-white p-8 md:p-10 rounded-lg shadow-md border-t-4 border-brand-orange mt-12 mb-20">
    <h1 class="text-3xl font-bold text-brand-dark mb-2 font-body">List Your Business</h1>
    <p class="text-gray-600 mb-8 font-body">Join the Kisumu Sorted directory. Fill out the details below and our team will review your submission.</p>
    
    <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6 font-body">
      <!-- Replace YOUR_ACCESS_KEY with the same key from your contact page -->
      <input type="hidden" name="access_key" value="b56ba381-19d1-433e-9068-86a2d91c7eac">
      
      <!-- Spam Protection -->
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="businessName" class="block text-sm font-medium text-brand-dark mb-1">Business Name *</label>
          <input type="text" id="businessName" name="Business Name" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition-shadow">
        </div>
        
        <div>
          <label for="category" class="block text-sm font-medium text-brand-dark mb-1">Category *</label>
          <select id="category" name="Category" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition-shadow bg-white">
            <option value="" disabled selected>Select a category...</option>
            <option value="Eat & Drink">Eat & Drink</option>
            <option value="Places to Stay">Places to Stay</option>
            <option value="Music & Nightlife">Music & Nightlife</option>
            <option value="Shopping">Shopping</option>
            <option value="Services">Services</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="location" class="block text-sm font-medium text-brand-dark mb-1">Neighborhood / Location *</label>
          <input type="text" id="location" name="Location" placeholder="e.g., Milimani, CBD" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition-shadow">
        </div>

        <div>
          <label for="phone" class="block text-sm font-medium text-brand-dark mb-1">Contact Phone Number *</label>
          <input type="tel" id="phone" name="Phone Number" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition-shadow">
        </div>
      </div>

      <div>
        <label for="description" class="block text-sm font-medium text-brand-dark mb-1">Short Description *</label>
        <textarea id="description" name="Description" rows="4" placeholder="Tell us what makes this business special..." required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition-shadow"></textarea>
      </div>

      <div>
        <label for="social" class="block text-sm font-medium text-brand-dark mb-1">Instagram/Social Media Link (Optional)</label>
        <input type="url" id="social" name="Social Link" placeholder="https://instagram.com/..." class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brand-green focus:border-transparent outline-none transition-shadow">
      </div>

      <button type="submit" class="w-full bg-brand-orange text-brand-dark font-bold py-3 px-4 rounded-md hover:bg-orange-500 transition-colors shadow-sm text-lg mt-4">
        Submit Business for Review
      </button>
    </form>
  </div>
</Layout>