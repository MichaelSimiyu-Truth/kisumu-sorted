---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png'; 
---
<!-- Added 'relative' so the dropdown positions correctly -->
<header class="bg-brand-green text-white py-4 shadow-md border-b-4 border-brand-orange relative z-50">
  <div class="container mx-auto px-4 flex justify-between items-center max-w-5xl">
    
    <a href="/" class="flex items-center hover:opacity-95 transition-opacity">
      <Image 
        src={logoImage} 
        alt="Kisumu Sorted" 
        class="h-10 w-auto object-contain" 
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation (Hidden on Mobile) -->
    <nav class="hidden md:flex gap-6 font-body font-medium items-center">
      <a href="/" class="hover:text-brand-orange transition-colors">Home</a>
      <a href="/about" class="hover:text-brand-orange transition-colors">About</a>
      <a href="/contact" class="hover:text-brand-orange transition-colors">Contact</a>
      <a href="/apply" class="bg-brand-orange text-brand-dark px-5 py-2 rounded-full font-bold hover:bg-orange-500 transition-colors shadow-sm">
        List your business
      </a>
    </nav>

    <!-- Mobile Hamburger Button -->
    <button id="menu-toggle" class="md:hidden flex items-center p-2 focus:outline-none" aria-label="Toggle Menu">
      <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <nav id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-brand-green border-b-4 border-brand-orange shadow-lg md:hidden">
    <div class="flex flex-col px-4 py-6 space-y-4 font-body font-medium text-center">
      <a href="/" class="hover:text-brand-orange transition-colors text-lg">Home</a>
      <a href="/about" class="hover:text-brand-orange transition-colors text-lg">About</a>
      <a href="/contact" class="hover:text-brand-orange transition-colors text-lg">Contact</a>
      <a href="/apply" class="bg-brand-orange text-brand-dark px-5 py-3 rounded-full font-bold hover:bg-orange-500 transition-colors shadow-sm mt-2 w-3/4 mx-auto">
        List your business
      </a>
    </div>
  </nav>
</header>

<script>
  // Simple toggle logic for the mobile menu
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>