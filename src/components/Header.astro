---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png'; // Adjust path if you placed it inside a subfolder
---
<header class="bg-brand-green text-white py-4 shadow-md border-b-4 border-brand-orange">
  <div class="container mx-auto px-4 flex justify-between items-center max-w-5xl">
    
    <!-- Real Logo Image -->
    <a href="/" class="flex items-center hover:opacity-95 transition-opacity">
      <Image 
        src={logoImage} 
        alt="Kisumu Sorted" 
        class="h-10 w-auto object-contain" 
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex gap-6 font-body font-medium items-center">
      <a href="/" class="hover:text-brand-orange transition-colors">Home</a>
      <a href="/about" class="hover:text-brand-orange transition-colors">About</a>
      <a href="/contact" class="hover:text-brand-orange transition-colors">Contact</a>
      <a href="/apply" class="bg-brand-orange text-brand-dark px-5 py-2 rounded-full font-bold hover:bg-orange-500 transition-colors shadow-sm">
        List your business
      </a>
    </nav>
    
  </div>
</header>