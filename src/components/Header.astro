---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';

// Links are defined once and used in both menus
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const listHref = '/contact#get-listed';

// Works out which page we are on, for the active-link style
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header id="site-header" class="sticky top-0 z-50 border-b-4 border-brand-orange bg-brand-green py-4 text-white shadow-md">
  <div class="container mx-auto flex max-w-7xl items-center justify-between px-4 md:px-8">

    <a href="/" class="z-10 flex items-center transition-opacity hover:opacity-95" aria-label="Kisumu Sorted home">
      <Image src={logoImage} alt="Kisumu Sorted" class="h-10 w-auto object-contain" loading="eager" />
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-8 font-body font-medium md:flex" aria-label="Main">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`group relative transition-colors hover:text-brand-orange ${isActive(link.href) ? 'text-brand-orange' : ''}`}
        >
          {link.label}
          <!-- Underline: always shown on the current page, grows on hover for the others -->
          <span class={`absolute -bottom-1 left-0 h-0.5 bg-brand-orange transition-all duration-300 ${isActive(link.href) ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
        </a>
      ))}
      <a href={listHref} class="rounded-full bg-brand-orange px-5 py-2 font-bold text-brand-dark shadow-sm transition-colors hover:bg-brand-orange-dark">
        List your business
      </a>
    </nav>

    <!-- Mobile hamburger button (morphs into an X) -->
    <button
      id="menu-toggle"
      type="button"
      class="z-10 flex h-10 w-10 items-center justify-center rounded-lg md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <div class="relative h-5 w-6">
        <span id="line-1" class="absolute top-0 block h-0.5 w-6 bg-white transition-all duration-300"></span>
        <span id="line-2" class="absolute top-2 block h-0.5 w-6 bg-white transition-all duration-300"></span>
        <span id="line-3" class="absolute top-4 block h-0.5 w-6 bg-white transition-all duration-300"></span>
      </div>
    </button>
  </div>

  <!-- Mobile menu. "invisible" while closed keeps hidden links out of the keyboard tab order. -->
  <nav
    id="mobile-menu"
    aria-label="Mobile"
    class="invisible absolute left-0 top-full max-h-0 w-full overflow-hidden border-b border-brand-orange bg-brand-green opacity-0 shadow-lg transition-all duration-300 md:hidden"
  >
    <div class="flex flex-col items-end px-6 py-4 text-right font-body font-medium">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`mobile-link block py-3 pl-6 text-xl transition-colors hover:text-brand-orange ${isActive(link.href) ? 'text-brand-orange' : ''}`}
        >
          {link.label}
        </a>
      ))}
      <a href={listHref} class="mobile-link mb-2 mt-3 rounded-full bg-brand-orange px-6 py-3 text-lg font-bold text-brand-dark hover:bg-brand-orange-dark">
        List your business
      </a>
    </div>
  </nav>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const mobileMenu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');
  const line1 = document.getElementById('line-1');
  const line2 = document.getElementById('line-2');
  const line3 = document.getElementById('line-3');

  let isMenuOpen = false;

  function setMenu(open: boolean) {
    isMenuOpen = open;

    // Tell assistive technology what state the button is in
    menuToggle?.setAttribute('aria-expanded', String(open));
    menuToggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');

    // Open or close the panel
    mobileMenu?.classList.toggle('max-h-0', !open);
    mobileMenu?.classList.toggle('opacity-0', !open);
    mobileMenu?.classList.toggle('invisible', !open);
    mobileMenu?.classList.toggle('max-h-[480px]', open);
    mobileMenu?.classList.toggle('opacity-100', open);
    mobileMenu?.classList.toggle('visible', open);

    // Morph the hamburger into an X (and back)
    line1?.classList.toggle('rotate-45', open);
    line1?.classList.toggle('translate-y-2', open);
    line2?.classList.toggle('opacity-0', open);
    line3?.classList.toggle('-rotate-45', open);
    line3?.classList.toggle('-translate-y-2', open);
  }

  menuToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenu(!isMenuOpen);
  });

  // Close when a link is tapped
  document.querySelectorAll('.mobile-link').forEach((link) =>
    link.addEventListener('click', () => { if (isMenuOpen) setMenu(false); })
  );

  // Close when tapping outside the header
  document.addEventListener('click', (e) => {
    if (isMenuOpen && header && !header.contains(e.target as Node)) setMenu(false);
  });

  // Close with Escape, and hand focus back to the button
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      setMenu(false);
      menuToggle?.focus();
    }
  });
</script>