---
const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-dark text-brand-lightgreen pt-12 pb-6 mt-12 border-t-4 border-brand-orange font-body">
  <div class="container mx-auto px-4 md:px-8 max-w-7xl">
    
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10 text-center md:text-left">
      
      <!-- Column 1: Brand Info -->
      <div class="flex flex-col items-center md:items-start">
        <h3 class="text-white text-xl font-bold mb-4 tracking-wide">Kisumu Sorted</h3>
        <p class="text-sm leading-relaxed max-w-sm">
          The premier local directory for finding the best places to eat, stay, and explore in Kisumu city.
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="flex flex-col items-center md:items-start">
        <h3 class="text-white text-lg font-bold mb-4">Quick Links</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/" class="hover:text-brand-orange transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-brand-orange transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-brand-orange transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Column 3: Social Media -->
      <div class="flex flex-col items-center md:items-start">
        <h3 class="text-white text-lg font-bold mb-4">Follow Us</h3>
        <div class="flex gap-5">
          <!-- Instagram -->
