    <!-- Bottom Legal Bar -->
    <div class="border-t border-brand-lightgreen/20 pt-6 flex flex-col md:flex-row justify-between items-center text-xs opacity-75">
      <p class="mb-4 md:mb-0">&copy; {currentYear} Kisumu Sorted. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-brand-orange transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-brand-orange transition-colors">Terms of Service</a>
      </div>
    </div>
    
