---
import Icon from './Icon.astro';
import { urls } from '../lib/site';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/contact', label: 'Contact' },
  { href: '/contact#get-listed', label: 'List your business' },
];

const socials = [
  { label: 'Instagram', href: urls.instagram, icon: 'instagram' },
  { label: 'TikTok', href: urls.tiktok, icon: 'tiktok' },
  { label: 'WhatsApp channel', href: urls.channel, icon: 'whatsapp' },
] as const;
---

<footer class="mt-12 border-t-4 border-brand-orange bg-brand-dark pb-6 pt-12 font-body text-brand-lightgreen">
  <div class="container mx-auto max-w-7xl px-4 md:px-8">

    <div class="mb-10 grid grid-cols-1 gap-8 text-center md:grid-cols-3 md:text-left">

      <!-- Brand -->
      <div class="flex flex-col items-center md:items-start">
        <h3 class="mb-4 font-heading text-lg font-bold text-white">Kisumu Sorted<span class="text-brand-orange">.</span></h3>
        <p class="max-w-sm text-sm leading-relaxed">
          A local guide to places to eat, stay and explore in Kisumu.
        </p>
      </div>

      <!-- Quick links -->
      <nav class="flex flex-col items-center md:items-start" aria-label="Footer">
        <h3 class="mb-4 font-heading text-lg font-bold text-white">Quick Links</h3>
        <ul class="space-y-3 text-sm">
          {quickLinks.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-brand-orange">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Social media -->
      <div class="flex flex-col items-center md:items-start">
        <h3 class="mb-4 font-heading text-lg font-bold text-white">Follow Us</h3>
        <!-- p-2 makes each icon a bigger tap target; -ml-2 keeps them lined up with the text above on desktop -->
        <div class="flex gap-3 md:-ml-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="rounded-lg p-2 transition-colors hover:text-brand-orange"
            >
              <Icon name={s.icon} class="h-6 w-6" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-brand-lightgreen/20 pt-6 text-center text-xs opacity-75">
      <p>&copy; {currentYear} Kisumu Sorted. All rights reserved.</p>
    </div>

  </div>
</footer>